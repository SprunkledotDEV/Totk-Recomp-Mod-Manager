<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>BsDiff</id>
    <version>1.1.0</version>
    <authors>Logos Bible Software</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/LogosBible/bsdiff.net</projectUrl>
    <description>.NET port of bsdiff, Colin Pervical's binary diff/patch utility, in 100% managed code.</description>
    <releaseNotes>https://github.com/LogosBible/bsdiff.net/blob/master/ReleaseNotes.md</releaseNotes>
    <copyright>Copyright 2010-2024 Logos Bible Software</copyright>
    <tags>bsdiff bspatch binary patch</tags>
    <repository type="git" url="https://github.com/LogosBible/bsdiff.net.git" commit="662685f1927916a1a802a9a1298bbda542e7876b" />
    <dependencies>
      <group targetFramework="net6.0">
        <dependency id="SharpZipLib" version="1.4.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="SharpZipLib" version="1.4.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="SharpZipLib" version="1.4.2" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>